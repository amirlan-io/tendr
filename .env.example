# ──────────────────────────────────────────────
# Tendr — переменные окружения
# Скопируйте в .env и заполните реальными значениями
# .env НЕ коммитится в git
# ──────────────────────────────────────────────

# === Общее ===
APP_ENV=dev                       # dev | prod
APP_NAME=tendr
DEFAULT_LANG=ru                   # ru | kk
LOG_LEVEL=INFO

# === База данных ===
# PostgreSQL — основной вариант.
DATABASE_URL=postgresql+asyncpg://tendr:tendr@localhost:5432/tendr
DATABASE_URL_SYNC=postgresql://tendr:tendr@localhost:5432/tendr
# Альтернатива для слабого ПК или тестов (без Docker):
# DATABASE_URL=sqlite+aiosqlite:///./tendr.db
# DATABASE_URL_SYNC=sqlite:///./tendr.db

# === Redis (для FSM бота и кеша) ===
REDIS_URL=redis://localhost:6379/0

# === LLM-провайдер ===
#
# Основной — AlemLLM qwen3-6 (умнее, быстрее, лучше vision для PDF).
# Резервный — Mistral Large (если alemLLM недоступен).
# Эмбеддинги — всегда через Mistral (alemLLM не умеет embeddings).
#
# Возможные значения LLM_PROVIDER:
#   openai-compatible  → primary = alemLLM (qwen3-6), secondary = Mistral
#   mistral            → primary = Mistral, secondary = alemLLM
#
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your_alemllm_api_key_here
LLM_API_KEY_FALLBACK=your_mistral_api_key_here
LLM_BASE_URL=https://llm.alem.ai/v1
LLM_MODEL=qwen3-6
LLM_EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIM=1024

# AlemLLM параметры (используются при LLM_PROVIDER=mistral для secondary)
ALEM_BASE_URL=https://llm.alem.ai/v1
ALEM_MODEL=qwen3-6

# === Эмбеддер ===
#   llm:   использует LLM-провайдер (через Mistral — работает всегда)
#   local: sentence-transformers (на CPU медленнее, но бесплатно)
EMBEDDING_PROVIDER=llm
EMBEDDING_LOCAL_MODEL=intfloat/multilingual-e5-small

# === Telegram-бот ===
# Токен от @BotFather (/newbot → /revoke для сброса, если «утек»)
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=6431458502     # ваш Telegram ID, можно несколько через запятую

# === goszakup.gov.kz (API-токен OWS) ===
# Получить: https://ows.goszakup.gov.kz/ → регистрация → профиль
# Версия v2 — стабильная (GraphQL + REST /trd-buy/{id}).
# Версия v3 — экспериментальная (некоторые поля отличаются).
GOSZAKUP_API_URL=https://ows.goszakup.gov.kz/v2
GOSZAKUP_API_TOKEN=

# === Qdrant (векторная БД для RAG) ===
# Три варианта:
#   1. local://../data/qdrant  — локальный режим (без Docker, in-memory + disk)
#   2. http://localhost:6333   — Docker-контейнер через docker compose up -d
#   3. https://your-cloud.qdrant.io  — Qdrant Cloud
QDRANT_URL=local://../data/qdrant
QDRANT_API_KEY=

# === Freemium ===
FREE_TIER_APPLICATIONS_PER_MONTH=3
PILOT_FREE_TIER_APPLICATIONS_PER_MONTH=999

# === Наблюдаемость (опционально) ===
SENTRY_DSN=

# === Tavily (поиск товаров в KZ-магазинах) ===
# Получить: https://tavily.com/ → бесплатный тариф = 1000 запросов/мес
TAVILY_API_KEY=

# === Browser Use (облачный браузерный агент) ===
# Получить бесплатно: python scripts/browser_use/signup.py
# Cloud v3: gpt-5.4-mini, claude-sonnet-4.6, claude-opus-4.6
# Cloud v2: browser-use-2.0 (своя LLM, дешевле)
BROWSER_USE_API_KEY=
